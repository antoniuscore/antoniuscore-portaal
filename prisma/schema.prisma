// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SectorType {
  BRUILOFT
  EVENEMENTEN_FEEST
  BOUW_RENOVATIE
  ZAKELIJK_CORPORATE
  CATERING_HORECA
  MARKETING_MEDIA_FOTOGRAFIE
  AUTOMOTIVE_LOGISTIEK
  BEAUTY_LIFESTYLE
  ONDERWIJS_WORKSHOPS
  KUNST_ENTERTAINMENT
}

enum RequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  company       Company?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Deal {
  id        String   @id @default(cuid())
  title     String
  company   String
  amount    Float
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
}

model Company {
  id                        String                 @id @default(cuid())
  userId                    String                 @unique
  user                      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug                      String?                @unique
  name                      String
  description               String?
  logoUrl                   String?
  websiteUrl                String?
  city                      String?
  latitude                  Float?
  longitude                 Float?
  serviceRadiusKm           Int?                   @default(30)
  availableStaff            Int?                   @default(1)
  clientCapacityPerProduct   Int?                   @default(5)
  isMarketplaceVisible      Boolean                @default(true)
  businessType              String?
  googlePlaceId             String?
  recommendedCompanies      String[]               @default([])
  blacklistedCompanies      String[]               @default([])
  kvkNumber                 String?
  vatNumber                 String?
  address                   String?
  primarySector             SectorType
  openForSectors            SectorType[]
  openingHours              OpeningHour[]
  reviews                   Review[]
  products                  Product[]
  bundles                   BundleCompany[]
  customRequests            CustomRequestCompany[]
  createdAt                 DateTime               @default(now())
}

model OpeningHour {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dayOfWeek Int      // 0 = Zondag, 1 = Maandag, ... 6 = Zaterdag
  openTime  String   // e.g. "09:00"
  closeTime String   // e.g. "18:00"
  isClosed  Boolean  @default(false)

  @@unique([companyId, dayOfWeek])
}

model Review {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  authorName String
  rating     Int      @default(5)
  comment    String?
  createdAt  DateTime @default(now())
}

model Product {
  id          String       @id @default(cuid())
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Float
  imageUrl    String?
  isTop5      Boolean      @default(false)
  createdAt   DateTime     @default(now())
  bundleItems BundleItem[]
}

model Bundle {
  id          String          @id @default(cuid())
  title       String
  description String?
  sector      SectorType
  price       Float
  isPreMade   Boolean         @default(true)
  companies   BundleCompany[]
  items       BundleItem[]
  createdAt   DateTime        @default(now())
}

model BundleCompany {
  bundleId  String
  companyId String
  bundle    Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([bundleId, companyId])
}

model BundleItem {
  bundleId  String
  productId String
  bundle    Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([bundleId, productId])
}

model CustomRequest {
  id            String                 @id @default(cuid())
  customerEmail String
  customerName  String
  sector        SectorType
  status        RequestStatus          @default(PENDING)
  companies     CustomRequestCompany[]
  createdAt     DateTime               @default(now())
}

model CustomRequestCompany {
  requestId String
  companyId String
  request   CustomRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([requestId, companyId])
}
